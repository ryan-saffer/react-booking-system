{
    "compilerOptions": {
        "module": "commonjs",
        "noImplicitReturns": false,
        "noUnusedLocals": true,
        "sourceMap": true,
        "strict": true,
        "target": "es2020",
        "allowJs": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["*"],
        "paths": {
            "fizz-kidz": ["./fizz-kidz/src"],
            "@/*": ["./src/*"]
        },
        "noErrorTruncation": true
    },
    "include": ["src", "src/environment.d.ts", "declarations/index.d.ts"]
}
