{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "bracketSpacing": true,
    "sortImports": {
        "customGroups": [
            {
                "groupName": "fizz-kidz",
                "elementNamePattern": ["fizz-kidz", "fizz-kidz/**"]
            },
            {
                "groupName": "internal-aliases",
                "elementNamePattern": ["@/**"]
            }
        ],
        "groups": [
            "builtin",
            "external",
            "fizz-kidz",
            "internal-aliases",
            ["parent", "sibling", "index", "style", "side_effect_style"],
            "type",
            "unknown"
        ],
        "ignoreCase": true,
        "newlinesBetween": true
    },
    "sortPackageJson": false
}
