---
import Image from "@/components/image.astro";
import logo from "@/assets/images/logo-white.png";
import { RECALL_URL, RECALL_LABEL } from "@/utils/constants";
import { PUBLIC_STUDIOS } from "@/utils/studios";
---

<footer
  id="footer"
  class="flex min-h-60 w-full flex-col items-center bg-zinc-800 p-8"
>
  <div class="flex w-full max-w-7xl flex-1 items-center justify-between gap-8">
    <div
      class="grid grid-cols-1 justify-between gap-6 text-white sm:grid-cols-2 xl:grid-cols-4"
    >
      {
        PUBLIC_STUDIOS.map((studio) => (
          <div class="flex w-fit flex-col">
            <p class="font-lilita">{studio.name}</p>
            <p class="text-xs text-gray-300">
              <span class="font-bold">Email: </span>
              bookings@fizzkidz.com.au
            </p>
            <p class="text-xs text-gray-300">
              <span class="font-bold">Address: </span>
              {studio.streetAddress}, {studio.addressLocality} VIC {studio.postalCode}
            </p>
            <p class="text-xs text-gray-300">
              <span class="font-bold">Call: </span>
              (03) 9059 8144
            </p>
          </div>
        ))
      }
    </div>
    <div>
      <Image
        src={logo}
        alt="fizz kids logo in white"
        class="h-48 w-fit object-contain"
      />
    </div>
  </div>
  <div class="mt-8 w-full max-w-7xl border-t border-zinc-700 pt-4">
    <p class="text-xs text-gray-400">
      Product safety recall: {RECALL_LABEL}.{" "}
      <a
        href={RECALL_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-2 hover:text-white"
      >
        View the recall notice
      </a>
    </p>
  </div>
</footer>
