---
import CreationsSummary from "@/components/creations-summary.astro";
import Creations from "@/components/party-package-creations.astro";
import TsBathBombs from "@/components/creations/ts-bath-bombs.astro";
import TsBracelets from "@/components/creations/ts-bracelets.astro";
import TsRainbowBathBombs from "@/components/creations/ts-rainbow-bath-bombs.astro";
import TsMidnightsSlime from "@/components/creations/ts-midnights-slime.astro";
import TsLipBalm from "@/components/creations/ts-lip-balm.astro";
import TsFacePaint from "@/components/creations/ts-face-paint.astro";
import GlitterFaceShimmer from "@/components/creations/glitter-face-shimmer.astro";
import SparklingLipBalm from "@/components/creations/sparkling-lip-balm.astro";
import CharmKeyrings from "@/components/creations/charm-keyrings.astro";
import SparkleCrowns from "@/components/creations/sparkle-crowns.astro";

type Props = {
  variant?: "summary" | "party";
  image?: ImageMetadata;
  imageAlt?: string;
};

const {
  variant = "summary",
  image,
  imageAlt = "Taylor Swift Party Package",
} = Astro.props;

const creations = [
  TsBathBombs,
  TsBracelets,
  TsRainbowBathBombs,
  TsMidnightsSlime,
  TsLipBalm,
  TsFacePaint,
  GlitterFaceShimmer,
  SparklingLipBalm,
  SparkleCrowns,
  CharmKeyrings,
];
---

{
  variant === "party" ? (
    <Creations
      partyPackage="Taylor Swift"
      image={image!}
      imageAlt={imageAlt}
      useDefaultSlot
    >
      {creations.map((Creation) => (
        <div>
          <Creation flippable={false} />
        </div>
      ))}
    </Creations>
  ) : (
    <CreationsSummary
      title="Taylor Swift Creations"
      color="#9044E2"
      useDefaultSlot
    >
      {creations.map((Creation) => (
        <Creation flippable={false} />
      ))}
    </CreationsSummary>
  )
}
