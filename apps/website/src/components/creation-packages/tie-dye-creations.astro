---
import CreationsSummary from "@/components/creations-summary.astro";
import Creations from "@/components/party-package-creations.astro";
import TieDyeToteBags from "@/components/creations/tie-dye-tote-bags.astro";
import TieDyePillow from "@/components/creations/tie-dye-pillow.astro";
import RainbowCrystals from "@/components/creations/rainbow-crystals.astro";
import RainbowSlime from "@/components/creations/rainbow-slime.astro";

type Props = {
  variant?: "summary" | "party";
  image?: ImageMetadata;
  imageAlt?: string;
};

const {
  variant = "summary",
  image,
  imageAlt = "Tie Dye Party Package",
} = Astro.props;

const creations = [TieDyeToteBags, TieDyePillow, RainbowCrystals, RainbowSlime];
---

{
  variant === "party" ? (
    <Creations
      partyPackage="Tie Dye"
      image={image!}
      imageAlt={imageAlt}
      useDefaultSlot
    >
      {creations.map((Creation) => (
        <div>
          <Creation flippable={false} />
        </div>
      ))}
    </Creations>
  ) : (
    <CreationsSummary title="Tie Dye Creations" color="#F7BB35" useDefaultSlot>
      {creations.map((Creation) => (
        <Creation flippable={false} />
      ))}
    </CreationsSummary>
  )
}
