---
import FlipCreation from "../flip-creation.astro";

import { sbCreationsBubblingVolcanoesPng as creation } from "@/data/storyblok-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Bubbling Volcanoes"]}
  color="red"
/>
