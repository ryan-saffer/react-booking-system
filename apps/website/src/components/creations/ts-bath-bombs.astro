---
import FlipCreation from "../flip-creation.astro";

import { sbCreationsTsBathBombsPng as creation } from "@/data/storyblok-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["'Speak Now' Purple Bath Bombs"]}
  color="yellow"
/>
