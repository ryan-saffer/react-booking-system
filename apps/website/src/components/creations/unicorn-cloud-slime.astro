---
import FlipCreation from "../flip-creation.astro";

import { sbCreationsUnicornCloudSlimePng as creation } from "@/data/storyblok-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Unicorn Cloud Slime"]}
  color="pink"
/>
