---
import FlipCreation from "../flip-creation.astro";

import { sbCreationsHendrixGlitterShinePng as creation } from "@/data/storyblok-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Huntrix Glitter Shimmer"]}
  color="blue"
/>
