---
import FlipCreation from "../flip-creation.astro";

import { sbCreationsMonsterExplosionsPng as glitterSlime } from "@/data/storyblok-images";

type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={glitterSlime}
  text={["Monster Explosions"]}
  color="green"
/>
