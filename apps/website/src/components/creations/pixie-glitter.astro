---
import FlipCreation from "../flip-creation.astro";

import { sbCreationsPixieGlitterPng as creation } from "@/data/storyblok-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Pixie Glitter Shimmer"]}
  color="purple"
/>
