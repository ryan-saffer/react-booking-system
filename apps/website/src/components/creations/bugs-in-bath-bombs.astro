---
import FlipCreation from "../flip-creation.astro";

import { sbCreationsBugsInBathBombsPng as creation } from "@/data/storyblok-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Bugs in Bath Bombs"]}
  color="green"
/>
