---
import FlipCreation from "../flip-creation.astro";

import creation from "@/assets/images/creations/fire-potions.png";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Dragon Fire Potions"]}
  color="red"
/>
