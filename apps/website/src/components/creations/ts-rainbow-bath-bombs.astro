---
import FlipCreation from "../flip-creation.astro";

import { sbCreationsTsRainbowBathBombsPng as creation } from "@/data/storyblok-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["'Lover' Rainbow Bath Bombs"]}
  color="blue"
/>
