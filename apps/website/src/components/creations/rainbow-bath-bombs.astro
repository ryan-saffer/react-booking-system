---
import FlipCreation from "../flip-creation.astro";

import { sbCreationsRainbowBathBombsPng as creation } from "@/data/storyblok-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Rainbow Bath Bombs"]}
  color="yellow"
/>
