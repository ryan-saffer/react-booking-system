---
import PageIntro from "@/components/page-intro.astro";
import Layout from "@/layout/Layout.astro";
import PartyLayout from "@/layout/party-layout.astro";

import jungleSafariParty from "@/assets/images/pages/parties/safari-party.jpg";
import bubblingVocanoes from "@/assets/images/creations/bubbling-volcanoes.png";
import JungleSafariCreations from "@/components/creation-packages/jungle-safari-creations.astro";
---

<Layout
  title="Book a Kids Jungle Safari Animal Birthday Party in Melbourne | Fizz Kidz"
  description="This party package will take the kids on a safari adventure!"
>
  <PartyLayout partyPackage="Jungle Safari">
    <PageIntro
      slot="intro"
      subtitle="Roar! Welcome to the jungle!"
      type="image"
      image={jungleSafariParty}
      imageAlt="hands holding colourful body glitter containers"
      actionButtonText="Book a party"
      actionButtonPath="/birthday-parties/book-a-party/#book"
      color="green"
    >
      <span slot="title">Jungle Safari Kids Birthday Parties</span>
      <span slot="content">
        Join the safari adventure and make your own jungle creations!
      </span>
    </PageIntro>
    <JungleSafariCreations
      variant="party"
      image={bubblingVocanoes}
      imageAlt="Jungle Safari Party Package"
    />
  </PartyLayout>
</Layout>
