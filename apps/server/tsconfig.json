{
    "compilerOptions": {
        "module": "commonjs",
        "noImplicitReturns": false,
        "noUnusedLocals": true,
        "sourceMap": true,
        "strict": true,
        "target": "es2020",
        "allowJs": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["*"],
        "paths": {
            "@fizz-kidz/core": ["../../packages/core/src"],
            "@/*": ["./src/*"],
            "@test-support/*": ["./test-support/*"]
        },
        "noErrorTruncation": true
    },
    "include": ["src", "scripts", "test-support", "src/environment.d.ts", "declarations/index.d.ts"]
}
